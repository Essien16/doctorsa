<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    >
    <title>{{title}} | DoctorSA</title>
    <link rel="stylesheet" href="/public/styles.css">
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/doctor/requests">
        DoctorSA
      </a>

      <nav class="header-navigation">
        <a
          class="navigation-link"
          href="/doctor/requests"
        >
          Open requests
        </a>

        <a
          class="navigation-link active"
          href="/doctor/assigned-visits"
        >
          Assigned visits
        </a>

        <form method="post" action="/logout">
          <button
            class="button-secondary"
            type="submit"
          >
            Sign out
          </button>
        </form>
      </nav>
    </header>

    <main class="page-container">
      <div class="page-heading">
        <div>
          <h1>Assigned visits</h1>

          <p class="muted">
            Visits assigned to you after successful
            patient payment.
          </p>
        </div>
      </div>

      {{#hasVisits}}
        <div class="assigned-grid">
          {{#visits}}
            <article class="assigned-card">
              <div class="visit-card-heading">
                <div>
                  <p class="eyebrow">
                    {{specialtyName}}
                  </p>

                  <h2>{{patientName}}</h2>
                </div>

                <span class="status status-assigned">
                  ASSIGNED
                </span>
              </div>

              <dl class="details-list">
                <div>
                  <dt>Location</dt>
                  <dd>{{location}}</dd>
                </div>

                <div>
                  <dt>Appointment time</dt>
                  <dd>{{preferredAt}}</dd>
                </div>

                <div>
                  <dt>Agreed price</dt>
                  <dd>{{amount}}</dd>
                </div>

                <div>
                  <dt>Assigned at</dt>
                  <dd>{{assignedAt}}</dd>
                </div>
              </dl>

              <div class="appointment-note">
                <strong>Your bid note</strong>
                <p>{{bidNote}}</p>
              </div>
            </article>
          {{/visits}}
        </div>
      {{/hasVisits}}

      {{^hasVisits}}
        <section class="empty-state">
          <h2>No assigned visits</h2>

          <p>
            Visits will appear here after a patient
            selects your bid and completes payment.
          </p>

          <a
            class="button-link"
            href="/doctor/requests"
          >
            View open requests
          </a>
        </section>
      {{/hasVisits}}
    </main>
  </body>
</html>