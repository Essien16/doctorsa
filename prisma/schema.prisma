// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  DOCTOR
}

enum VisitStatus {
  OPEN
  BIDDING
  PAID
  ASSIGNED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole

  doctorProfile DoctorProfile?
  patientVisits Visit[]        @relation("PatientVisits")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model DoctorProfile {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @unique @map("user_id") @db.Uuid
  specialtyId String @map("specialty_id") @db.Uuid

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id])
  bids      Bid[]

  assignedVisits Visit[] @relation("AssignedDoctor")
  reservedVisits Visit[] @relation("ReservedDoctor")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([specialtyId])
  @@map("doctor_profiles")
}

model Specialty {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)

  doctorProfiles DoctorProfile[]
  visits         Visit[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("specialties")
}

model Visit {
  id          String @id @default(uuid()) @db.Uuid
  patientId   String @map("patient_id") @db.Uuid
  specialtyId String @map("specialty_id") @db.Uuid

  selectedBidId           String? @unique @map("selected_bid_id") @db.Uuid
  assignedDoctorProfileId String? @map("assigned_doctor_profile_id") @db.Uuid
  reservedDoctorProfileId String? @map("reserved_doctor_profile_id") @db.Uuid

  location                   String      @db.VarChar(255)
  preferredAt                DateTime    @map("preferred_at") @db.Timestamptz(3)
  scheduledEndAt             DateTime    @map("scheduled_end_at") @db.Timestamptz(3)
  doctorReservationExpiresAt DateTime?   @map("doctor_reservation_expires_at") @db.Timestamptz(3)
  status                     VisitStatus @default(OPEN)

  patient   User      @relation("PatientVisits", fields: [patientId], references: [id])
  specialty Specialty @relation(fields: [specialtyId], references: [id])

  selectedBid    Bid?           @relation("SelectedBid", fields: [selectedBidId], references: [id], onDelete: SetNull)
  assignedDoctor DoctorProfile? @relation("AssignedDoctor", fields: [assignedDoctorProfileId], references: [id], onDelete: SetNull)
  reservedDoctor DoctorProfile? @relation("ReservedDoctor", fields: [reservedDoctorProfileId], references: [id], onDelete: SetNull)

  bids          Bid[]                @relation("VisitBids")
  payment       Payment?
  statusHistory VisitStatusHistory[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([patientId])
  @@index([specialtyId, status])
  @@index([assignedDoctorProfileId])
  @@index([reservedDoctorProfileId])
  @@index([doctorReservationExpiresAt])
  @@map("visits")
}

model Bid {
  id              String @id @default(uuid()) @db.Uuid
  visitId         String @map("visit_id") @db.Uuid
  doctorProfileId String @map("doctor_profile_id") @db.Uuid
  amountInKobo    Int    @map("amount_in_kobo")
  note            String @db.VarChar(280)

  visit         Visit         @relation("VisitBids", fields: [visitId], references: [id], onDelete: Cascade)
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id])

  selectedForVisit Visit?   @relation("SelectedBid")
  payment          Payment?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([visitId, doctorProfileId])
  @@index([visitId])
  @@index([doctorProfileId])
  @@map("bids")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  visitId           String        @unique @map("visit_id") @db.Uuid
  bidId             String        @unique @map("bid_id") @db.Uuid
  providerReference String        @unique @map("provider_reference") @db.VarChar(100)
  amountInKobo      Int           @map("amount_in_kobo")
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(3)

  visit Visit @relation(fields: [visitId], references: [id])
  bid   Bid   @relation(fields: [bidId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("payments")
}

model WebhookEvent {
  id              String @id @default(uuid()) @db.Uuid
  providerEventId String @unique @map("provider_event_id") @db.VarChar(100)
  eventType       String @map("event_type") @db.VarChar(100)
  payload         Json

  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("webhook_events")
}

model VisitStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  visitId    String       @map("visit_id") @db.Uuid
  fromStatus VisitStatus? @map("from_status")
  toStatus   VisitStatus  @map("to_status")

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([visitId, createdAt])
  @@map("visit_status_history")
}

model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("session")
}
